{
  "name": "@fcar/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "synth": "cdk synth --quiet",
    "cdk": "cdk",
    "deploy:backend": "cdk deploy fcar-backend -c fcar:activeColor=$(aws ssm get-parameter --name /fcar/active-color --query Parameter.Value --output text)"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1148.1"
  }
}
